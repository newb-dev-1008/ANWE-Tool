# Copy to .env. Never put credentials in browser code or commit this file with real values.
# Gemini supports free-tier usage subject to Google's availability and quota.
# Use a free-tier project without billing; the app cannot verify your billing tier.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional alternative: explicitly choose AI_PROVIDER=openai to use these.
OPENAI_API_KEY=
# Choose a Responses API model supporting strict structured output in your account.
OPENAI_MODEL=gpt-4.1-mini
AI_MAX_REQUESTS_PER_DAY=20
AI_MAX_OUTPUT_TOKENS=4000
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
CDSE_MAX_ANALYSES_PER_DAY=3
PORT=8080
